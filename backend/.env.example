# OpenRouter API Key for Cloud Mode (retrieve from https://openrouter.ai/)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Base URL for OpenRouter API (do not change)
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Cloud Mode default model choice
OPENROUTER_MODEL=google/gemini-2.5-flash

# Local Ollama Configurations
OLLAMA_MODEL=llama3.1
# Set to http://host.docker.internal:11434 if executing inside Docker container (Windows/Mac)
OLLAMA_BASE_URL=http://localhost:11434
